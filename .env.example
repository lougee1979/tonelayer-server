# Copy this file to .env and fill in your values
# Never commit .env to git

# Your Anthropic API key — get it at console.anthropic.com
CLAUDE_API_KEY=sk-ant-your-key-here

# A secret token your apps send with every request
# Make this long and random — keep it private
APP_TOKEN=change-this-to-a-long-random-secret

# Port (Railway/Render set this automatically)
PORT=3000
