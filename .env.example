# Copy this file to .env and fill in your values
# Never commit .env to git

# Your Anthropic API key — get it at console.anthropic.com
CLAUDE_API_KEY=sk-ant-your-key-here

# A secret token your apps send with every request
# Make this long and random — keep it private
APP_TOKEN=change-this-to-a-long-random-secret

# A separate secret token YOU use to view /analytics/summary
# (anonymous usage stats for funders/insurers). Make this long and random too.
ADMIN_TOKEN=change-this-to-a-different-long-random-secret

# Hume AI (Empathic Voice Interface) credentials — get them at platform.hume.ai
# Powers /hume/session, used by the browser extension's voice feature.
# The iOS/Android apps authenticate with Hume directly and don't need this.
HUME_API_KEY=your-hume-api-key-here
HUME_SECRET_KEY=your-hume-secret-key-here
# Optional — defaults to the same EVI config ID the apps use if unset.
HUME_CONFIG_ID=b65c1f98-4dc7-404f-a6de-30ca963ced1d

# Port (Railway/Render set this automatically)
PORT=3000

# OpenAI API key — get it at platform.openai.com
# Powers cross-conversation relationship analysis (deliberately OpenAI, not
# Claude — a third provider alongside Claude for rewrite/refine and Hume for
# voice tone).
OPENAI_API_KEY=sk-proj-your-key-here
